# 사이트 공개 URL (OG metadataBase)
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# 서버(프록시/SSR) → 백엔드
# 백엔드 로컬 주소에 맞게 수정
API_BASE_URL=http://localhost:3001

# 백엔드와 공유하는 시크릿 (서버 전용, NEXT_PUBLIC_ 아님)
PROXY_SECRET=proxy_secret

# 카카오 주소 검색 API 키
KAKAO_REST_API_KEY=kakao_rest_api_key

# 카카오 JavaScript SDK 키 (브라우저에서 Kakao.init 하므로 NEXT_PUBLIC_ 필요)
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=kakao_javascript_key

# 토스페이먼츠 클라이언트 키 (결제창 호출용, 공개돼도 되는 값. 시크릿 키는 백엔드에만 둔다)
# 개발자센터 > API 개별 연동 키의 "test_ck_..." 테스트 키를 넣는다
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_toss_client_key

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://mykey.ingest.us.sentry.io/123
SENTRY_AUTH_TOKEN=sentry_auth_token

# 채팅 Socket.IO — 브라우저가 Next 프록시를 거치지 않고 BE에 직접 WebSocket 연결하므로
# NEXT_PUBLIC_ 필요. 인증은 쿠키 기반이라 FE·BE가 같은 상위 도메인이어야 한다(BE COOKIE_DOMAIN 참고)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Google Analytics 측정 ID
# 비우면 수집과 동의 배너를 켜지 않는다
NEXT_PUBLIC_GA_ID=G-1234567890

# 랜딩 시연 영상 유튜브 ID
# 비우면 OG 이미지를 보여 준다. 예시 값을 넣으면 그 ID로 재생한다
NEXT_PUBLIC_DEMO_VIDEO_ID=
